#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
export HOST_UID=$(id -u) HOST_GID=$(id -g)
export HOST_GROUPS=$(id -G | tr ' ' ',')
[[ $HOST_UID != 0 ]] || { echo 'Run as your normal user.' >&2; exit 2; }
export EDF_TARGET=${EDF_TARGET:-zc702}
if [[ ${1:-} == --target ]]; then export EDF_TARGET=${2:?Specify target}; shift 2; fi
[[ $EDF_TARGET =~ ^[a-z0-9-]+$ && -f config/targets/$EDF_TARGET.sh ]] || {
  echo "Unsupported target: $EDF_TARGET; PolarFire remains in the original environment." >&2; exit 2;
}
dc() { docker ${EDF_DOCKER_CONTEXT:+--context "$EDF_DOCKER_CONTEXT"} compose "$@"; }
case "${1:-image}" in
  config) exec docker ${EDF_DOCKER_CONTEXT:+--context "$EDF_DOCKER_CONTEXT"} compose config ;;
  build-container) dc build shell; exit ;;
  stop) dc down; exit ;;
  help|--help|-h)
    echo 'Usage: ./edf [--target zc702|zcu111|arty-z7-20] [image|boot|linux|sdk|check|validate|shell|export|qemu|qemu-prepare|BITBAKE_ARGS...]'
    echo 'EDF_DOCKER_CONTEXT=orbstack selects OrbStack; default uses the current Docker context.'
    exit ;;
esac
# Bind source directories must exist with invoking-user ownership, never root-owned fallback directories.
resolved_artifacts=$(python3 scripts/host-config.py)
export EDF_ARTIFACTS="$resolved_artifacts"
dc up -d --build --wait hashserv
case "${1:-image}" in
  shell|qemu|qemu-prepare) exec docker ${EDF_DOCKER_CONTEXT:+--context "$EDF_DOCKER_CONTEXT"} compose run --rm --no-deps shell /opt/edf-scripts/build.sh "$@" ;;
  *) exec python3 scripts/run-build.py "$EDF_TARGET" "${@:-image}" ;;
esac
