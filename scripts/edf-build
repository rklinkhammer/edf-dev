#!/bin/bash
# Interactive commands execute inside the current container, never launch Docker.
set -euo pipefail
usage() {
  echo 'Usage: edf-build {boot|linux|sdk|check|qemu|qemu-prepare|help}'
  echo "Target: ${EDF_TARGET:-zc702} (selected by ./edf shell TARGET)"
}
[[ $# -le 1 ]] || { usage >&2; exit 2; }
case "${1:-help}" in
  help|-h|--help) usage; exit 0 ;;
  boot|linux|sdk|check) helper=/opt/edf-scripts/build.sh; action=$1 ;;
  qemu) helper=/opt/edf-scripts/qemu.sh; action=boot ;;
  qemu-prepare) helper=/opt/edf-scripts/qemu.sh; action=prepare ;;
  *) usage >&2; exit 2 ;;
esac
source /opt/edf-config/targets.sh
# Keep SDK compiler environment out of the BitBake environment.
[[ -z ${OECORE_TARGET_SYSROOT:-} ]] || {
  echo 'An SDK environment is active. Open a fresh ./edf shell for builds.' >&2
  exit 2
}
[[ -t 0 && -t 1 ]] || {
  echo 'edf-build requires an interactive terminal; use ./edf commands for unattended builds.' >&2
  exit 2
}
mkdir -p "/artifacts/logs/$EDF_TARGET"
log="/artifacts/logs/$EDF_TARGET/$(date -u +%Y%m%dT%H%M%SZ)-$1-$$.log"
printf 'Target: %s\nConsole log: %s\n' "$EDF_TARGET" "$log"
# A PTY keeps BitBake and QEMU interactive, while recording the console.
# Arguments above are allowlisted; no user-supplied shell command is evaluated.
exec script --quiet --return --flush --command "/bin/bash $helper $action" "$log"
